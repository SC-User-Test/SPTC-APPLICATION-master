<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-feed" value="/tmp/local-nuget-feed" />
    <add key="global-cache" value="/app/.nuget/packages" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="/app/.nuget/packages" />
  </config>
</configuration>
