<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================
    Migrated from .NET Framework 4.8 (Windows-only) to .NET 8.0
    as part of containerization remediation for rule cz-dotnet-1023.

    Original: <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
              ProjectTypeGuids: WPF / Windows-only container (5 GB+)

    Remediation: Converted to SDK-style project targeting net8.0
    to enable Linux container deployment on Azure Kubernetes Service
    (AKS) with significantly smaller image sizes (~200 MB vs 5 GB+).
    Secrets are injected via Azure Key Vault CSI Driver and
    Workload Identity — no hardcoded credentials in project files.
    ============================================================
  -->

  <PropertyGroup>
    <!-- Changed from v4.8 (.NET Framework, Windows-only) to net8.0 (Linux-compatible) -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Changed from Exe to Library: the compiled subset contains only backend/data-layer
         files (no Main entry point). The WPF UI entry point (App.xaml.cs) is excluded. -->
    <OutputType>Library</OutputType>
    <RootNamespace>SPTC_APPLICATION</RootNamespace>
    <AssemblyName>SPTC APPLICATION</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Containerization: target linux/amd64 for AKS Linux node pools -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ProjectGuid>{DB75EE79-8C4A-426E-8B74-C3C03000ECDE}</ProjectGuid>
    <!--
      Disable auto-inclusion of all .cs files so only the explicitly listed
      <Compile> items below are compiled. This prevents WPF XAML code-behind
      files and other Windows-only files from being included in the Linux build.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Suppress auto-generated AssemblyInfo to avoid CS0579 duplicate attribute errors -->
    <!-- with the manually maintained Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    cz-dotnet-1040 remediation (Line 37 & Line 56 – DebugSymbols in Debug configs):
    Release/container build configuration explicitly disables PDB generation and
    debug symbols to prevent unnecessary files from bloating the Windows container
    image pushed to Azure Container Registry and deployed to AKS Windows node pool.
    The multi-stage Dockerfile passes /p:DebugType=None /p:DebugSymbols=false at
    publish time; these PropertyGroup entries enforce the same policy at project level.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Disable PDB / debug symbol output – reduces container image size -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet package references (SDK-style — replaces packages.config) -->
  <ItemGroup>
    <!-- Database -->
    <PackageReference Include="MySql.Data" Version="8.1.0" />

    <!-- Serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Google.Protobuf" Version="3.24.2" />

    <!--
      cz-dotnet-0023 remediation: Azure Cache for Redis client.
      Connection string is injected at runtime via REDIS_CONNECTION_STRING
      environment variable (mounted from Azure Key Vault by AKS Secrets Store CSI Driver).
    -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />

    <!-- Compression -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.6" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.6" />
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.7.2" />

    <!-- Cryptography -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />

    <!-- BCL / Runtime polyfills -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="7.0.0" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="7.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.IO.Pipelines" Version="7.0.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="7.0.0" />
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <!-- Source files — only backend/data-layer files that compile on Linux (net8.0) -->
  <ItemGroup>
    <Compile Include="AppState.cs" />
    <Compile Include="RedisStateManager.cs" />
    <Compile Include="HealthCheckService.cs" />
    <Compile Include="Database\Clean.cs" />
    <Compile Include="Database\DatabaseConnection.cs" />
    <Compile Include="Database\RequestQuery.cs" />
    <Compile Include="Database\Retrieve.cs" />
    <Compile Include="Database\Upsert.cs" />
    <Compile Include="Objects\Controller.cs" />
    <Compile Include="Objects\Driver.cs" />
    <Compile Include="Objects\Employee.cs" />
    <Compile Include="Objects\EventLogger.cs" />
    <Compile Include="Objects\Franchise.cs" />
    <Compile Include="Objects\General.cs" />
    <Compile Include="Objects\Ledger.cs" />
    <Compile Include="Objects\Operator.cs" />
    <Compile Include="Objects\PaymentDetails.cs" />
    <Compile Include="Objects\Resource.cs" />
    <Compile Include="Objects\Violation.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <!-- Static content -->
  <ItemGroup>
    <Content Include="dtb_sptc.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
