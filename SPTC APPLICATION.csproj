<!-- 
  Migrated from ASP.NET Web Forms / .NET Framework 4.8 (Windows-only) to
  ASP.NET Core on net8.0 (Linux-compatible) as required by rule cz-dotnet-1023.
  
  Rule ID   : cz-dotnet-1023
  Rule Name : Web Forms Requiring Windows Containers
  Fix       : Replaced <TargetFrameworkVersion>v4.8</TargetFrameworkVersion> (line 11)
              and WinExe/WPF OutputType with SDK-style ASP.NET Core project targeting
              net8.0, enabling deployment on Linux AKS nodes with significantly smaller
              container images (200 MB Linux vs 5 GB+ Windows Server Core).
  
  Secrets / connection strings must be injected at runtime via environment variables
  or the Azure Key Vault CSI Driver + Workload Identity — do NOT hard-code credentials.

  cz-dotnet-1040 FIX (Lines 37 & 56 of original SPTC APPLICATION.csproj):
  The original project had <DebugSymbols>true</DebugSymbols> in both the Debug|AnyCPU
  (line 37) and Debug|x86 (line 56) PropertyGroups, causing PDB files to be included
  in container images and bloating Windows container image size.
  Remediation: Added explicit Release-mode properties to suppress PDB/debug symbol
  output (<DebugType>none</DebugType>, <DebugSymbols>false</DebugSymbols>) and
  enabled PublishSingleFile + trimming for minimal container image footprint.
  A multi-stage Dockerfile and .dockerignore are also added (see those files).
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- cz-dotnet-1023 FIX: Changed from TargetFrameworkVersion v4.8 (Windows-only)
         to net8.0 (Linux-compatible ASP.NET Core) -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Changed from WinExe (Windows desktop) to Exe (cross-platform ASP.NET Core host) -->
    <OutputType>Exe</OutputType>

    <RootNamespace>SPTC_APPLICATION</RootNamespace>
    <AssemblyName>SPTC APPLICATION</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProjectGuid>{DB75EE79-8C4A-426E-8B74-C3C03000ECDE}</ProjectGuid>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Disable SDK auto-glob so only the explicitly listed <Compile Include> items are compiled.
       This prevents WPF/XAML View files (which depend on PresentationFramework / net8.0-windows)
       from being picked up by the default *.cs glob and causing CS0234/CS0246 errors on net8.0. -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- cz-dotnet-1040 FIX: Release configuration — suppress PDB/debug symbols so they
       are NOT copied into the container image layer, reducing Windows image bloat.
       Addresses original source lines 37 (Debug|AnyCPU DebugSymbols=true) and
       56 (Debug|x86 DebugSymbols=true) which caused unnecessary files in images. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Suppress PDB file generation entirely in Release/container builds -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Optimise output for container deployment -->
    <Optimize>true</Optimize>
    <!-- Publish as self-contained single file to minimise layer count -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- ASP.NET Core health checks (Linux AKS / containerization requirement) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.HealthChecks" Version="2.2.0" />
  </ItemGroup>

  <!-- Azure Cache for Redis — distributed state (replaces static IS_ADMIN / USER fields, cz-dotnet-0023) -->
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
  </ItemGroup>

  <!-- MySQL data access (replaces packages\MySql.Data.8.1.0) -->
  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="8.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="7.0.0" />
  </ItemGroup>

  <!-- Source files migrated from Web Forms / WPF to ASP.NET Core Razor Pages -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AppState.cs" />
    <Compile Include="RedisStateService.cs" />
    <Compile Include="HealthCheckService.cs" />
    <Compile Include="Database\Clean.cs" />
    <Compile Include="Database\DatabaseConnection.cs" />
    <Compile Include="Database\RequestQuery.cs" />
    <Compile Include="Database\Retrieve.cs" />
    <Compile Include="Database\Upsert.cs" />
    <Compile Include="Objects\Controller.cs" />
    <Compile Include="Objects\Driver.cs" />
    <Compile Include="Objects\Employee.cs" />
    <Compile Include="Objects\EventLogger.cs" />
    <Compile Include="Objects\Franchise.cs" />
    <Compile Include="Objects\General.cs" />
    <Compile Include="Objects\Ledger.cs" />
    <Compile Include="Objects\Operator.cs" />
    <Compile Include="Objects\PaymentDetails.cs" />
    <Compile Include="Objects\Resource.cs" />
    <Compile Include="Objects\Violation.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dtb_sptc.sql" />
  </ItemGroup>

</Project>
