<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  MIGRATION NOTE (cz-dotnet-1023 – Web Forms Requiring Windows Containers)
  ============================================================
  Original project targeted .NET Framework v4.8 with WPF/WinExe output type,
  which mandates Windows Server Core base images (5 GB+) for containerisation.

  This file has been converted to the SDK-style project format targeting
  net8.0 so the application can be built and deployed on Linux AKS nodes
  using lightweight Linux container images (~200 MB).

  Key changes applied
  ===================
  1. Replaced <TargetFrameworkVersion>v4.8</TargetFrameworkVersion> (line 11)
     with <TargetFramework>net8.0</TargetFramework> inside an SDK-style
     <Project Sdk="Microsoft.NET.Sdk.Web"> element.
  2. Removed Windows-only <ProjectTypeGuids> (WPF GUID
     {60dc8134-eba5-43b8-bcc9-bb4bc16c2548}) that forced Windows containers.
  3. Changed <OutputType> from WinExe to Exe (headless / server process).
  4. Replaced packages.config NuGet references with SDK-style
     <PackageReference> items using Linux-compatible package versions.
  5. Retained HealthCheckService.cs (HTTP /health endpoint) already present
     in the codebase for container liveness/readiness probes.
  6. Added Microsoft.AspNetCore.App framework reference to enable the
     ASP.NET Core web host used by the migrated Razor Pages entry point.
  ============================================================
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- *** BLOCKER FIX cz-dotnet-1023 ***
  ============================================================
  MIGRATION NOTE (cz-dotnet-1040 – Unoptimized Web Forms Container Image Size)
  ============================================================
  Multi-stage Dockerfile and .dockerignore have been added to the project root
  to produce a minimal Linux container image for AKS deployment.
  Release builds are configured to suppress PDB generation (DebugType=none,
  DebugSymbols=false) so debug symbols are not included in the published output,
  reducing the final container image size.
  ============================================================ -->
    <!-- *** BLOCKER FIX cz-dotnet-1023 ***
         Original line 11: <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
         Replaced with net8.0 to enable Linux container deployment on AKS. -->
    <TargetFramework>net8.0</TargetFramework>

    <RootNamespace>SPTC_APPLICATION</RootNamespace>
    <AssemblyName>SPTC APPLICATION</AssemblyName>

    <!-- Headless server process – no Windows desktop subsystem required -->
    <OutputType>Exe</OutputType>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- Ensure the published image targets Linux -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Assembly metadata (previously in Properties/AssemblyInfo.cs) -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © 2023</Copyright>
    <Product>SPTC APPLICATION</Product>

    <!-- Prevent duplicate assembly attribute errors from Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- *** BLOCKER FIX cz-dotnet-1040 – Line 37 (source): DebugSymbols in Debug config ***
       Suppress PDB / debug-symbol output in Release builds so that .pdb files
       are not copied into the published container image layer, reducing image size.
       Source line 37: <DebugSymbols>true</DebugSymbols> (Debug|AnyCPU config)
       Source line 56: <DebugSymbols>true</DebugSymbols> (Debug|x86 config) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Disable PDB generation for Release/publish builds targeting containers -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Strip unnecessary metadata from the published output -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Publish single-file to reduce file count in the container layer -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Trim unused assemblies to reduce image footprint -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- ================================================================
       NuGet package references – SDK-style, Linux-compatible versions
       (replaces the old packages.config / <Reference HintPath="…"> model)
       ================================================================ -->
  <ItemGroup>
    <!-- MySQL data access -->
    <PackageReference Include="MySql.Data" Version="8.1.0" />

    <!-- JSON serialisation -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- ASP.NET Core health-check middleware (supports /health endpoint) -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.HealthChecks" Version="2.2.0" />

    <!-- Azure Key Vault CSI / Workload Identity secret injection support -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.0" />
    <PackageReference Include="Azure.Identity" Version="1.10.4" />

    <!-- Async helpers -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="7.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />

    <!-- *** BLOCKER FIX cz-dotnet-0023 – Static Variables for State ***
         Azure Cache for Redis client used by RedisStateProvider to replace
         the static mutable List<string> Employees field (AppState.cs line 28).
         Connection string is injected via REDIS_CONNECTION_STRING env var
         (mounted by Azure Key Vault CSI Driver / Workload Identity on AKS). -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.10" />
  </ItemGroup>

  <!-- ================================================================
       Source files
       All .cs files under the project root are included automatically
       by the SDK glob; explicit <Compile> entries are not required.
       XAML / WPF page files are intentionally excluded – the UI layer
       is being migrated to ASP.NET Core Razor Pages (see Pages/ folder).
       ================================================================ -->

  <!-- Exclude legacy WPF XAML code-behind files that are Windows-only -->
  <ItemGroup>
    <Compile Remove="View\**\*.xaml.cs" />
    <!-- Exclude WPF-specific View/Controls files that reference System.Windows/PresentationFramework -->
    <Compile Remove="View\Controls\DataGridHelper.cs" />
    <Compile Remove="View\Controls\OutlinedText.cs" />
    <Compile Remove="View\Controls\Scaler.cs" />
    <None Include="View\Controls\DataGridHelper.cs" />
    <None Include="View\Controls\OutlinedText.cs" />
    <None Include="View\Controls\Scaler.cs" />
    <!-- Exclude DialogHelper (references commented-out WPF TextBox/Label) -->
    <Compile Remove="View\Controls\DialogHelper.cs" />
    <None Include="View\**\*.xaml" />
    <None Include="View\**\*.xaml.cs" />
  </ItemGroup>

  <!-- Exclude App.xaml / App.xaml.cs (WPF Application entry point) –
       replaced by Program.cs / Startup.cs ASP.NET Core entry point -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <None Include="App.xaml" />
    <None Include="App.xaml.cs" />
  </ItemGroup>

  <!-- Static web assets (images, icons) -->
  <ItemGroup>
    <Content Include="View\Images\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SQL seed script -->
  <ItemGroup>
    <Content Include="dtb_sptc.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
