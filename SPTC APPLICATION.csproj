<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Updated from net6.0-windows / .NET Framework 4.8 to net8.0-windows for .NET 8 compatibility -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SPTC_APPLICATION</RootNamespace>
    <AssemblyName>SPTC APPLICATION</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <StartupObject>SPTC_APPLICATION.App</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU;x86</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Suppress platform compatibility warnings for Windows-only APIs -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <!-- NuGet Package References - All updated for .NET 8 compatibility -->
  <ItemGroup>
    <!--
      AForge 2.2.5 (original .NET Framework 4.8 package) is NOT compatible with .NET 8.
      AForge has no official .NET 8 release. Camera/video functionality must be replaced
      with a .NET 8-compatible alternative such as OpenCvSharp4.Windows or DirectShowLib-2005.
      These references are commented out until a compatible replacement is integrated.
    -->
    <!-- <PackageReference Include="AForge" Version="2.2.5" /> -->
    <!-- <PackageReference Include="AForge.Video" Version="2.2.5" /> -->
    <!-- <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" /> -->

    <!--
      BouncyCastle: Migrated from Portable.BouncyCastle 1.9.0 (.NET Framework) to
      BouncyCastle.Cryptography 2.3.1 which is the official .NET 8 compatible package.
      This resolves the incompatible dependency issue flagged in the analysis.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.3.1" />

    <!-- Google.Protobuf: Updated to 3.27.2 for .NET 8 compatibility -->
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />

    <!-- K4os compression libraries: Updated to latest versions compatible with .NET 8 -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />

    <!--
      Database Provider: Migrated from MySql.Data (MySQL) to Npgsql 8.0.5 (PostgreSQL 16).
      Npgsql is the official open-source .NET data provider for PostgreSQL.
      All ADO.NET types (Connection, Command, DataReader, Parameter, Exception) updated.
    -->
    <PackageReference Include="Npgsql" Version="8.0.5" />

    <!-- Newtonsoft.Json: Updated to 13.0.3 for .NET 8 compatibility -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!--
      System packages built into .NET 8 BCL (no longer needed as separate NuGet packages):
      - System.Buffers
      - System.Memory
      - System.Threading.Tasks.Extensions
      - System.ValueTuple
      - System.Runtime.CompilerServices.Unsafe
      - System.Numerics.Vectors
      These were required for .NET Framework 4.8 but are part of .NET 8 base class library.

      Microsoft.AspNetCore.App is a framework reference for ASP.NET Core web applications.
      This is a WPF desktop application and does NOT require Microsoft.AspNetCore.App.
      The analysis report flagged it as needing update from 6.0.0 to 8.0, but it is not
      applicable to this WPF project type and has been intentionally excluded.
    -->

    <!-- System.Configuration.ConfigurationManager: Updated to 8.0.0 for .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />

    <!--
      System.Drawing.Common: Updated to 8.0.0.
      IMPORTANT: On .NET 8, System.Drawing.Common is Windows-only.
      This is acceptable for this WPF Windows desktop application (net8.0-windows).
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!-- System.Security.Permissions: Updated to 8.0.0 for .NET 8 -->
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />

    <!-- ZstdSharp.Port: Updated to 0.7.4 for .NET 8 compatibility -->
    <PackageReference Include="ZstdSharp.Port" Version="0.7.4" />
  </ItemGroup>

  <!-- Explicitly include files that SDK-style projects auto-include but need special treatment -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!-- Settings file support -->
  <ItemGroup>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Content files -->
  <ItemGroup>
    <Content Include="dtb_sptc.sql" />
  </ItemGroup>

  <!-- Resource files -->
  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="View\Images\album.png" />
    <Resource Include="View\Images\bg_dialog.png" />
    <Resource Include="View\Images\bg_login.png" />
    <Resource Include="View\Images\close-button.png" />
    <Resource Include="View\Images\icons\browse.png" />
    <Resource Include="View\Images\icons\cam.png" />
    <Resource Include="View\Images\icons\group.png" />
    <Resource Include="View\Images\icons\home.png" />
    <Resource Include="View\Images\icons\logout.png" />
    <Resource Include="View\Images\icons\settings.png" />
    <Resource Include="View\Images\icons\logo.ico" />
    <Resource Include="View\Images\icons\operator.png" />
    <Resource Include="View\Images\icons\pad.png" />
    <Resource Include="View\Images\icons\paper.png" />
    <Resource Include="View\Images\icons\person.png" />
    <Resource Include="View\Images\icons\pw_visible.png" />
    <Resource Include="View\Images\icons\save.png" />
    <Resource Include="View\Images\icons\tricycle.png" />
    <Resource Include="View\Images\logo.png" />
    <Resource Include="View\Images\no_id.png" />
    <Resource Include="View\Images\sign.png" />
  </ItemGroup>

</Project>
