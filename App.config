<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager, Version=8.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51">
            <section name="SPTC_APPLICATION.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager, Version=8.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <!-- NOTE: <startup> and <supportedRuntime> are not used in .NET 8 (they are .NET Framework-only) -->
    <!-- The runtime is determined by the SDK and TargetFramework in the .csproj -->
    <userSettings>
        <SPTC_APPLICATION.Properties.Settings>
            <setting name="Host" serializeAs="String">
                <value>localhost</value>
            </setting>
            <setting name="Port" serializeAs="String">
                <!-- Updated from MySQL default port 3306 to PostgreSQL default port 5432 -->
                <value>5432</value>
            </setting>
            <setting name="Database" serializeAs="String">
                <value>dtb_sptc</value>
            </setting>
            <setting name="Username" serializeAs="String">
                <value>postgres</value>
            </setting>
            <setting name="Password" serializeAs="String">
                <value />
            </setting>
        </SPTC_APPLICATION.Properties.Settings>
    </userSettings>
</configuration>
